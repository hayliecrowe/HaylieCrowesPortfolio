                    <input type="email" placeholder="Your Email Address" required
                           class="w-full p-4 focus:ring-0 rounded-lg transition duration-300 form-input">
                    <textarea placeholder="Tell me about your project" required rows="5"
                              class="w-full p-4 focus:ring-0 rounded-lg transition duration-300 form-input"></textarea>
                    
                    <button type="submit" class="w-full px-8 py-4 text-lg font-medium rounded-lg accent-button uppercase tracking-widest mt-6">
                        Send Confidential Inquiry
                    </button>
                    <!-- NOTE: The form logic (in the <script> below) only shows a confirmation message, it does not actually send email. You would need a backend service for that. -->
                    <div id="formMessage" class="mt-4 h-6" style="color: var(--c-text-secondary);"></div>
                </form>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="py-12 px-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center text-center md:text-left text-sm transition duration-300">
            <!-- EDIT HERE: Update copyright year/name -->
            <p class="footer-text">&copy; 2025 Haylie Crowe. All Rights Reserved.</p>
            <div class="space-x-4 mt-4 md:mt-0">
                <!-- EDIT HERE: Update social media links -->
                <a href="#" class="footer-link">LinkedIn</a>
                <a href="#" class="footer-link">Dribbble</a>
                <a href="#" class="footer-link">Medium</a>
            </div>
        </div>
    </footer>

    <!-- JavaScript for Interactions, Scroll Reveal, Particles, and New Effects -->
    <script>
        // Use an IIFE (Immediately Invoked Function Expression) to scope the variables
        (function() {
            /**
             * GLOBAL ELEMENTS
             */
            const scrollProgress = document.getElementById('scroll-progress');
            const footerContent = document.querySelector('footer div');
            const footerLinks = document.querySelectorAll('footer .footer-link');
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const body = document.body;

            /**
             * --- THEME SWITCHING LOGIC ---
             * (No editing needed here)
             */
            function setIcon(isLight) {
                if (themeIcon) {
                    // Update icon based on the current mode (sun for dark mode, moon for light mode)
                    themeIcon.classList.toggle('fa-sun', !isLight);
                    themeIcon.classList.toggle('fa-moon', isLight);
                }
            }

            function loadTheme() {
                const storedTheme = localStorage.getItem('theme');
                // Check if user has a preference, otherwise check system, then default to dark
                if (storedTheme === 'light') {
                    body.classList.add('light-mode');
                    setIcon(true);
                } else if (storedTheme === 'dark') {
                    body.classList.remove('light-mode');
                    setIcon(false);
                } else {
                    // Check system preference if no stored theme
                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                        body.classList.add('light-mode');
                        setIcon(true);
                    } else {
                        // Default to dark mode
                        body.classList.remove('light-mode');
                        setIcon(false);
                    }
                }
            }
            
            function toggleTheme() {
                const isLight = body.classList.toggle('light-mode');
                
                // Save preference to localStorage
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
                setIcon(isLight);
            }

            // Initialize theme on load
            loadTheme();
            if (themeToggle) {
                themeToggle.addEventListener('click', toggleTheme);
            }
            
            /**
             * Scroll Reveal Logic for the 'exclusive' fade-in effect
             * (No editing needed here)
             */
            const revealElements = document.querySelectorAll('.reveal');

            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.1 
            };

            const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        // Adds 'active' class which triggers CSS opacity/transform and the line animation
                        entry.target.classList.add('active'); 
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            revealElements.forEach(el => {
                observer.observe(el);
            });

            /**
             * 1. Scroll Progress Bar Logic
             * (No editing needed here)
             */
            function updateScrollProgress() {
                if (!scrollProgress) return;
                
                const totalHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolled = window.scrollY;
                const progress = Math.min(100, Math.max(0, (scrolled / totalHeight) * 100));
                
                scrollProgress.style.width = progress + '%';
            }
            window.addEventListener('scroll', updateScrollProgress);
            updateScrollProgress();

            /**
             * 2. Footer Interaction Logic (Dimming/Brightening)
             * (No editing needed here)
             */
            function setupFooterInteraction() {
                if (!footerContent) return;

                // Event listeners for hover/mouse interaction
                footerContent.parentElement.addEventListener('mouseenter', () => {
                    footerContent.querySelectorAll('.footer-text, .footer-link').forEach(el => {
                        el.style.color = 'var(--c-accent)'; // Brighten to accent color
                    });
                });

                footerContent.parentElement.addEventListener('mouseleave', () => {
                    setTimeout(() => {
                         if (!footerContent.contains(document.activeElement)) {
                            // Reset back to secondary text color
                            footerContent.querySelectorAll('.footer-text, .footer-link').forEach(el => {
                                el.style.color = 'var(--c-text-secondary)'; 
                            });
                            // Special case for footer-text to handle the base color
                            footerContent.querySelector('.footer-text').style.color = 'var(--c-text-secondary)';
                        }
                    }, 50);
                });
                
                // For touch/accessibility, ensure focus brightens the whole footer
                footerLinks.forEach(link => {
                    link.addEventListener('focus', () => {
                         footerContent.querySelectorAll('.footer-text, .footer-link').forEach(el => {
                            el.style.color = 'var(--c-accent)';
                        });
                    });
                    link.addEventListener('blur', () => {
                        setTimeout(() => {
                            if (!footerContent.contains(document.activeElement)) {
                                footerContent.querySelectorAll('.footer-text, .footer-link').forEach(el => {
                                    el.style.color = 'var(--c-text-secondary)';
                                });
                            }
                        }, 50);
                    });
                });
            }
            
            setupFooterInteraction();

            /**
             * Particle Animation Logic 
             * (No editing needed here)
             */
            const canvas = document.getElementById('particleCanvas');
            if (canvas) { 
                const ctx = canvas.getContext('2d');
                let particles = [];
                const particleCount = 30; 
                let lastTime = 0; 

                function resizeCanvas() {
                    canvas.width = canvas.offsetWidth;
                    canvas.height = canvas.offsetHeight;
                    initParticles();
                }
                
                resizeCanvas();
                window.addEventListener('resize', resizeCanvas);

                function Particle(x, y) {
                    this.x = x;
                    this.y = y;
                    this.size = Math.random() * 0.4 + 0.2; 
                    this.timeOffset = Math.random() * Math.PI * 2; 
                    
                    this.getParticleColor = function() {
                         const isLightMode = body.classList.contains('light-mode');
                         // Gold tint, very faint opacity (0.05 to 0.15)
                         const hue = isLightMode ? 40 : 45; 
                         const saturation = isLightMode ? 50 : 60;
                         const lightness = isLightMode ? 60 : 75;
                         const opacity = Math.random() * 0.1 + 0.05;

                         return 'hsla(' + hue + ', ' + saturation + '%, ' + lightness + '%, ' + opacity + ')'; 
                    };
                    this.color = this.getParticleColor();
                }

                Particle.prototype.update = function(time) {
                    this.x += Math.sin(time * 0.0001 + this.timeOffset) * 0.2; 
                    this.y += Math.cos(time * 0.00015 + this.timeOffset) * 0.1; 

                    if (this.x > canvas.width * 1.5 || this.x < -canvas.width * 0.5 ||
                        this.y > canvas.height * 1.5 || this.y < -canvas.height * 0.5) {
                        
                        if (Math.random() < 0.5) {
                            this.x = Math.random() < 0.5 ? -10 : canvas.width + 10;
                            this.y = Math.random() * canvas.height;
                        } else {
                            this.x = Math.random() * canvas.width;
                            this.y = Math.random() < 0.5 ? -10 : canvas.height + 10;
                        }
                        this.color = this.getParticleColor(); 
                    }
                };

                Particle.prototype.draw = function() {
                    ctx.fillStyle = this.color;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fill();
                };

                function initParticles() {
                    particles = [];
                    for (let i = 0; i < particleCount; i++) {
                        const x = Math.random() * canvas.width;
                        const y = Math.random() * canvas.height;
                        particles.push(new Particle(x, y));
                    }
                }
                
                function animateParticles(timestamp) {
                    if (!lastTime) lastTime = timestamp; 

                    const bgColor = getComputedStyle(document.body).getPropertyValue('--c-bg-primary').trim();
                    ctx.fillStyle = bgColor; 
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    
                    for (let i = 0; i < particles.length; i++) {
                        particles[i].update(timestamp); 
                        particles[i].draw();
                    }
                    
                    requestAnimationFrame(animateParticles);
                }
                
                animateParticles();
            }

            /**
             * Contact Form Handling 
             * (NOTE: This only displays a confirmation message, it does NOT send email.)
             */
            const contactForm = document.getElementById('contactForm');
            const formMessage = document.getElementById('formMessage');

            contactForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const button = this.querySelector('button[type="submit"]');
                const originalText = button.textContent;
                
                button.textContent = 'Sending...';
                button.disabled = true;

                setTimeout(() => {
                    formMessage.style.color = 'var(--c-accent)';
                    formMessage.textContent = 'Thank you. Your inquiry has been received and will be reviewed shortly.';
                    
                    contactForm.reset();
                    button.textContent = originalText;
                    button.disabled = false;
                }, 1500);

            });
        })();
    </script>

</body>
