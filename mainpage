        :root {
            /* DARK MODE (Default) */
            --c-bg-primary: #0d0d0d;
            --c-bg-secondary: #181818;
            --c-text-primary: #f5f5f5;
            --c-text-secondary: #9ca3af; 
            --c-border: #374151;

            --c-accent: #C29F56; /* Rich Gold */
            --c-highlight: #FFEFB8;
            --c-header-bg: rgba(13, 13, 13, 0.85);
            --c-card-bg: rgba(24, 24, 24, 0.7); 
        }

        .light-mode {
            /* LIGHT MODE Overrides */
            --c-bg-primary: #ffffff;
            --c-bg-secondary: #f3f4f6;
            --c-text-primary: #1f2937;
            --c-text-secondary: #6b7280; 
            --c-border: #e5e7eb;

            --c-accent: #9a6d38; /* Darker Bronze for contrast on light BG */
            --c-highlight: #374151; /* Darker highlight for text/icons */
            --c-header-bg: rgba(255, 255, 255, 0.9);
            --c-card-bg: rgba(255, 255, 255, 0.9);
        }
        
        /* Apply variables to fundamental elements */
        body {
            background-color: var(--c-bg-primary);
            color: var(--c-text-primary);
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
            transition: background-color 0.4s ease, color 0.4s ease; /* Theme transition */
        }

        /* Set default font to Inter, but use a serif fallback for luxury headings */
        .luxury-heading {
            font-family: 'Playfair Display', Georgia, serif; 
            letter-spacing: 0.05em;
        }

        /* Subtle scroll reveal animation class */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        
        /* Pre-title line draw effect */
        .pre-title-effect {
            display: inline-block;
            position: relative;
        }
        .pre-title-effect::after {
            content: '';
            position: absolute;
            bottom: -8px; 
            left: 50%;
            transform: translateX(-50%);
            width: 0%; 
            height: 1px;
            background-color: var(--c-accent);
            opacity: 0;
        }
        
        /* Animation keyframes for the line drawing and fading */
        @keyframes drawLine {
            0% { width: 0%; opacity: 0; }
            20% { opacity: 1; }
            80% { width: 100%; opacity: 1; }
            100% { width: 100%; opacity: 0; }
        }
        
        .pre-title-effect.active::after {
            animation: drawLine 2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards 0.5s; 
        }
        
        /* --- NEW: HERO HEADING UNDERLINE EFFECT --- */
        .hero-underline {
            position: relative; /* Needed for ::after positioning */
            display: inline-block; /* Or block, depending on desired width */
        }
        .hero-underline::after {
            content: '';
            position: absolute;
            bottom: -15px; /* Adjust distance below text */
            left: 0;
            width: 0%; /* Start hidden */
            height: 2px; /* Thickness of the line */
            background-color: var(--c-accent);
            transition: background-color 0.4s ease; /* For theme change */
            animation: expandUnderline 1.5s ease-out forwards 1.2s; /* 1.2s delay to appear after text */
        }

        @keyframes expandUnderline {
            0% { width: 0%; opacity: 0; }
            50% { opacity: 1; }
            100% { width: 100%; opacity: 1; }
        }
        /* ------------------------------------------- */


        /* Header Styling */
        header {
            background-color: var(--c-header-bg);
            border-bottom: 1px solid var(--c-border);
        }

        /* Section Backgrounds */
        .bg-secondary-bg-theme {
            background-color: var(--c-bg-secondary);
            transition: background-color 0.4s ease;
        }

        /* Custom Card Hover Effect for Projects */
        .project-card {
            background-color: var(--c-card-bg);
            border: 1px solid transparent; /* Ensure border is part of transition */
            transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.4s ease, border-color 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .project-card:hover {
            transform: translateY(-5px);
            /* Soft, glowing spotlight effect from the gold accent */
            box-shadow: 0 10px 40px rgba(194, 159, 86, 0.15), 0 0 10px rgba(0, 0, 0, 0.1); 
        }

        .project-card:hover {
            border-color: var(--c-accent); /* Gold border on hover */
        }

        /* Custom Button Style */
        .accent-button {
            background-color: transparent;
            border: 1px solid var(--c-accent);
            color: var(--c-accent);
            transition: background-color 0.3s ease, color 0.3s ease, transform 0.1s ease, border-color 0.4s ease;
        }

        .accent-button:hover {
            background-color: var(--c-accent);
            color: var(--c-bg-primary); /* Use primary BG color for text on hover */
            transform: scale(1.03);
        }
        
        /* Form Inputs */
        .form-input {
            background-color: var(--c-bg-secondary);
            color: var(--c-text-primary);
            border-bottom: 1px solid var(--c-border);
            transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
        }
        .form-input:focus {
             border-color: var(--c-accent);
        }
        
        /* Specific style for the metallic 'Exceptional' word */
        .exceptional-pop {
            /* Even darker gold gradient */
            background-image: linear-gradient(to top, #7C5A1F, #A57C2F, #D4AF37, #FFFDD0); /* Deeper base, bright highlight */
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 600; 
            padding: 0 2px;
            
            /* Enhanced 3D look for deeper effect */
            text-shadow: 
                0 0 5px rgba(255, 223, 0, 0.3),            /* Light glow */
                0 1px 0 rgba(255, 255, 255, 0.5),          /* Top highlight */
                0 3px 0 rgba(100, 70, 0, 0.5),             /* Darker mid-tone for contrast */
                0 5px 0 var(--c-accent),                   /* Increased base offset (5px) */
                0 6px 2px rgba(0, 0, 0, 0.3),              /* Increased soft dark edge */
                0 12px 20px rgba(0, 0, 0, 0.4);            /* Deeper, wider drop shadow */
        }
        
        /* Scroll Progress Bar Style */
        #scroll-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 2px;
            background-color: var(--c-accent);
            width: 0%;
            transition: width 0.1s linear, background-color 0.4s ease; 
        }
        
        /* Footer dimming/fading style (Now uses theme colors) */
        footer {
            border-top: 1px solid var(--c-border);
            transition: border-color 0.4s ease;
        }
        .footer-text {
            color: var(--c-text-secondary);
            transition: color 0.4s ease;
        }
        .footer-link {
            transition: color 0.3s ease;
            color: var(--c-text-secondary); /* Initially dimmed */
        }
        .footer-link:hover {
            color: var(--c-accent); 
        }

        /* Placeholder styles adjusted to use variables */
        .placeholder {
            background-color: var(--c-bg-secondary);
            border-color: var(--c-accent);
            color: var(--c-text-secondary);
            transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
